<Window x:Class="FT8Hunter.CoreTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FT8 Hunter - Core Test" Height="850" Width="1180" MinHeight="760" MinWidth="1000">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="26" FontWeight="Bold" Text="FT8 Hunter — Core Test"/>
            <TextBlock Margin="0,4,0,0" Foreground="DimGray" Text="Milestone 3: FT8 RX/TX + primo QSO automatico"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Radio / OmniRig" Padding="10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Rig:" Margin="0,0,8,0"/>
                        <ComboBox x:Name="RigCombo" Width="100" SelectedIndex="0">
                            <ComboBoxItem Content="Rig 1" Tag="1"/>
                            <ComboBoxItem Content="Rig 2" Tag="2"/>
                        </ComboBox>
                        <Button Content="Connetti" Margin="10,0,0,0" Padding="14,5" Click="ConnectRig_Click"/>
                        <Button Content="Setup OmniRig" Margin="8,0,0,0" Padding="14,5" Click="SetupOmniRig_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="RigStatus" Margin="0,10,0,0" FontWeight="SemiBold" Text="Disconnesso" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock VerticalAlignment="Center" Text="Freq. RX Hz:" Margin="0,0,8,0"/>
                        <TextBox x:Name="FrequencyBox" Width="120" Text="14074000"/>
                        <Button Content="Imposta" Margin="8,0,0,0" Padding="12,4" Click="SetFrequency_Click"/>
                        <Button Content="14.074" Margin="8,0,0,0" Padding="12,4" Click="Tune20m_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock VerticalAlignment="Center" Text="Radio:" Margin="0,0,8,0"/>
                        <Button x:Name="UsbButton" Content="USB" Width="72" Padding="12,5" Click="UsbMode_Click"/>
                        <Button x:Name="DataButton" Content="DATA" Width="72" Margin="8,0,0,0" Padding="12,5" Click="DataMode_Click"/>
                        <ToggleButton x:Name="SplitButton" Content="SPLIT" Width="82" Margin="8,0,0,0" Padding="12,5"
                                      Checked="SplitButton_Checked" Unchecked="SplitButton_Unchecked"/>
                        <ToggleButton x:Name="RxModeLockButton" Content="LOCK RX" Width="92" Margin="8,0,0,0" Padding="12,5"
                                      Checked="RxModeLock_Checked" Unchecked="RxModeLock_Unchecked"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock VerticalAlignment="Center" Text="Posizione TX:" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxPositionBox" Width="70" Text="1500"/>
                        <TextBlock VerticalAlignment="Center" Text=" Hz" Margin="4,0,0,0"/>
                        <Button Content="Applica TX" Margin="10,0,0,0" Padding="12,4" Click="ApplyTxPosition_Click"/>
                        <CheckBox x:Name="TxFreqLockCheckBox" Content="LOCK TX FREQ" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                  Checked="TxFreqLock_Checked" Unchecked="TxFreqLock_Unchecked"/>
                        <TextBlock x:Name="TxSplitStatus" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold" Text="TX VFO B: --"/>
                    </StackPanel>

                    <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="DimGray"
                               Text="Con SPLIT attivo: VFO A = RX; VFO B = TX in USB-D. LOCK RX mantiene A in USB. LOCK TX FREQ impedisce ad Auto QSO e al doppio clic sui decode di spostare la posizione TX scelta; Applica TX può impostare manualmente una nuova frequenza bloccata."/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <CheckBox x:Name="ArmPtt" Content="ABILITA TEST PTT" VerticalAlignment="Center"/>
                        <Button Content="PTT ON" Margin="12,0,0,0" Padding="12,4" Click="PttOn_Click"/>
                        <Button Content="PTT OFF" Margin="8,0,0,0" Padding="12,4" Click="PttOff_Click"/>
                    </StackPanel>
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="DarkRed" Text="Il PTT manuale richiede esplicitamente la spunta di sicurezza."/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Motore FT8 interno" Padding="10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="MY CALL:" Margin="0,0,8,0"/>
                        <TextBox x:Name="MyCallBox" Width="100" Text="IU2JMZ"/>
                        <TextBlock VerticalAlignment="Center" Text="MY GRID:" Margin="12,0,8,0"/>
                        <TextBox x:Name="MyGridBox" Width="70"/>
                        <Button Content="Self-test FT8" Margin="10,0,0,0" Padding="12,5" Click="SelfTest_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock VerticalAlignment="Center" Text="Audio RX:" Margin="0,0,8,0"/>
                        <ComboBox x:Name="AudioCombo" Width="310"/>
                        <Button Content="Aggiorna" Margin="8,0,0,0" Padding="10,4" Click="RefreshAudio_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Avvia RX FT8" Padding="14,5" Click="StartFt8_Click"/>
                        <Button Content="Stop RX" Margin="8,0,0,0" Padding="14,5" Click="StopFt8_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="Ft8Status" Margin="0,8,0,0" FontWeight="SemiBold" Text="FT8 Engine fermo" TextWrapping="Wrap"/>

                    <Separator Margin="0,12,0,10"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Audio TX:" Margin="0,0,8,0"/>
                        <ComboBox x:Name="AudioTxCombo" Width="310"/>
                        <Button Content="Aggiorna" Margin="8,0,0,0" Padding="10,4" Click="RefreshTxAudio_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                        <TextBlock VerticalAlignment="Center" Text="Messaggio TX:" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxMessageBox" Width="270"/>
                        <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Foreground="DimGray" Text="es. CQ IU2JMZ GRID"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                        <TextBlock VerticalAlignment="Center" Text="Livello:" Margin="0,0,8,0"/>
                        <TextBox x:Name="TxLevelBox" Width="50" Text="30"/>
                        <TextBlock VerticalAlignment="Center" Text=" %" Margin="4,0,12,0"/>
                        <CheckBox x:Name="ArmFt8Tx" Content="ABILITA TX FT8" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="TX FT8 PROSSIMO SLOT" Padding="14,6" Click="TransmitFt8_Click"/>
                        <Button Content="STOP TX" Margin="8,0,0,0" Padding="14,6" Click="StopTransmitFt8_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="Ft8TxStatus" Margin="0,9,0,0" FontWeight="SemiBold" Text="TX FT8 fermo" TextWrapping="Wrap"/>
                    <TextBlock Margin="0,7,0,0" TextWrapping="Wrap" Foreground="DarkRed"
                               Text="Sicurezza: il TX FT8 richiede SPLIT attivo, Audio TX selezionato e la spunta ABILITA TX FT8. Il PTT viene aperto circa 250 ms prima dello slot UTC e rilasciato automaticamente a fine trama."/>

                    <Separator Margin="0,12,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="AVVIA CQ + AUTO QSO" Padding="14,6" Click="StartAutoQso_Click"/>
                        <Button Content="STOP AUTO" Margin="8,0,0,0" Padding="14,6" Click="StopAutoQso_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="AutoQsoStatus" Margin="0,9,0,0" FontWeight="SemiBold" Text="Auto QSO fermo" TextWrapping="Wrap"/>
                    <TextBlock Margin="0,5,0,0" Foreground="DimGray" TextWrapping="Wrap"
                               Text="Test automatico di un QSO: CQ → selezione della risposta più forte indirizzata a MY CALL → rapporto SNR → attesa R-report → RR73. Massimo 3 tentativi per fase; poi si ferma."/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="2" Header="Decode / Log test" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="13" HorizontalContentAlignment="Stretch" MouseDoubleClick="LogList_MouseDoubleClick"/>
                <Button Grid.Row="1" HorizontalAlignment="Right" Content="Pulisci" Margin="0,8,0,0" Padding="12,4" Click="ClearLog_Click"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
